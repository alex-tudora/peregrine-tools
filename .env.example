# Copy to .env.local in each app (or set in your Vercel project) as needed.
# All values below are PUBLIC client-side identifiers, not secrets.

# Google AdSense publisher id (e.g. ca-pub-1234567890123456).
# Falls back to the current hardcoded id if unset, so the app still builds.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-2865991938661915

# Per-tool AdSense slot ids are passed to <AdPlacement slot="..." /> where used.
# Until AdSense approves the account and real slot ids exist, <AdPlacement>
# reserves space and shows an "Advertisement" placeholder (no layout shift).
